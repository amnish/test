pipeline {
    agent any
    stages {
        stage('Pull the code') {
            steps {
                sh 'git branch: '', credentialsId: 'github3', url: 'https://github.com/amnish/test.git''
                }
                }
        stage ('Build & push docker image') {
            steps {
                docker build -t amnish90/app:1.1 .
                docker run amnish90/app:1.1
                }
               }
               
