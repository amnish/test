pipeline {
    agent any
    stages {
        stage('Pull the code') {
            steps {
                git url: 'https://github.com/amnish/test.git', branch: 'loginpage'
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                bat 'docker build -t app .'
                bat 'docker run -d app'
            }
        }
    }
}
