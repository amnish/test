pipeline {
    agent any
    stages {
        stage('Pull the code') {
            steps {
                git branch: '', credentialsId: 'github3', url: 'https://github.com/amnish/test.git'
                }
                }
        stage ('Build & push docker image') {
            steps {
                sh 'docker build -t amnish90/app:1.1 .'
                sh 'docker run amnish90/app:1.1'
                }
               }
               
