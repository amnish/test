pipeline {
    agent any
    stages {
        stage('Pull the code') {
            steps {
                git branch: 'loginpage', url: 'https://github.com/amnish/test.git'
                }
                }
        stage ('Build & push docker image') {
            steps {
                  docker build -t app .
                  docker run app
                }
               }
}
}
               
